{
  "name": "fawcett-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/payment-plans/*.test.mjs tests/admin-crm/*.test.mjs tests/studio-schedule/*.test.mjs tests/payments/*.test.mjs tests/ledger/*.test.mjs tests/legacy-import/*.test.mjs tests/agreements/*.test.mjs",
    "test:browser": "playwright test",
    "test:ledger": "node --test tests/ledger/*.test.mjs",
    "test:ledger:emulator": "node scripts/test-ledger-emulator.mjs",
    "test:legacy-import": "node --test tests/legacy-import/*.test.mjs",
    "reconcile:synthetic": "node scripts/reconcile-legacy-synthetic.mjs",
    "test:contracts": "node --test tests/agreements/*.test.mjs",
    "test:commands:emulator": "node scripts/test-financial-commands-emulator.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4"
  }
}
