# Local synthetic emulators ONLY. Never copy production Firebase settings here.
NEXT_PUBLIC_FIREBASE_MODE=emulator
# The six NEXT_PUBLIC_FIREBASE_* app settings may remain unset locally.
# Emulator mode supplies fixed demo configuration and rejects live values.
FIREBASE_ADMIN_PROJECT_ID=demo-fawcett-dev
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# No Firebase Admin key or GOOGLE_APPLICATION_CREDENTIALS needed or permitted.

# Preserve the disabled payment setting. Do not enter Square credentials.
SQUARE_ENVIRONMENT=sandbox
SQUARE_PAYMENTS_ENABLED=false
FOUNDER_CANONICAL_ORIGIN=http://localhost:3000
