# Local synthetic emulators ONLY. Never copy production Firebase settings here.
NEXT_PUBLIC_FIREBASE_MODE=emulator
# The six NEXT_PUBLIC_FIREBASE_* app settings may remain unset locally.
# Emulator mode supplies fixed demo configuration and rejects live values.
FIREBASE_ADMIN_PROJECT_ID=demo-fawcett-dev
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# No Firebase Admin key or GOOGLE_APPLICATION_CREDENTIALS needed or permitted.

# Preserve the disabled payment setting. Do not enter Square credentials.
SQUARE_ENVIRONMENT=sandbox
SQUARE_PAYMENTS_ENABLED=false
SQUARE_STUDIO_PAYMENTS_ENABLED=false
FOUNDER_CANONICAL_ORIGIN=http://localhost:3000

# Transactional notifications: disabled by default; no provider key in Codex.
NOTIFICATIONS_MODE=off
NOTIFICATIONS_ENABLED=false
# For fictional local testing only, choose test and set a current UTC watermark:
# NOTIFICATION_ACTIVATED_AT=<reviewed UTC timestamp before synthetic submission>
# NOTIFICATION_FROM=studio@example.test
# NOTIFICATION_STUDIO_RECIPIENTS=studio@example.test
# NOTIFICATION_PORTAL_ORIGIN=http://localhost:3000
# Local test delivery is an in-process sink, with no email network calls.
# CRON_SECRET, RESEND_API_KEY and RESEND_WEBHOOK_SECRET are server-only and
# are NOT needed for npm run test:notifications or notifications:test-tick.

# Firebase verification delivery: emulator-only locally. This switch gates LIVE
# verification delivery and remains false until separately approved deployment.
EMAIL_VERIFICATION_ENABLED=false
# Optional local-only return origin; fixed path /portal/verify-email is appended.
# EMAIL_VERIFICATION_ORIGIN=http://localhost:3000

# Phase 6A write permission comes from systemControls/writeFence, not an env flag.
# Missing/invalid control is closed. npm run seed:emulators initializes only demo
# fixtures as open; applications must never auto-open a missing production fence.
