rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function createsOwnRecord() {
      return signedIn()
        && request.resource.data.clientUid == request.auth.uid;
    }

    function createsValidMembershipApplication() {
      let data = request.resource.data;

      return signedIn()
        && data.keys().hasAll([
          "programName", "applicationType", "clientUid", "clientEmail",
          "clientName", "phone", "instagram", "preferredContactMethod",
          "status", "preferredArtist", "project", "coverUp", "budget",
          "timeline", "readiness", "acknowledgements", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "programName", "applicationType", "clientUid", "clientEmail",
          "clientName", "phone", "instagram", "preferredContactMethod",
          "status", "preferredArtist", "project", "coverUp", "budget",
          "timeline", "readiness", "acknowledgements", "createdAt", "updatedAt"
        ])
        && data.programName == "Tattoo Project Membership Program"
        && data.applicationType == "founding_member_interest"
        && data.clientUid is string && data.clientUid == request.auth.uid
        && data.clientEmail is string && data.clientEmail.matches('.*\\S.*') && data.clientEmail.size() <= 320
        && data.clientName is string && data.clientName.matches('.*\\S.*') && data.clientName.size() <= 120
        && data.phone is string && data.phone.matches('.*\\S.*') && data.phone.size() <= 50
        && data.instagram is string && data.instagram.size() <= 100
        && data.preferredContactMethod in ["email", "text", "phone", "instagram"]
        && data.status == "new"
        && data.preferredArtist in ["ben", "autumn", "no_preference", "not_sure"]
        && data.project is map
        && data.project.keys().hasAll(["projectType", "tattooIdea", "colourPreference", "placement", "bodySide", "sizeCategory", "detailLevel"])
        && data.project.keys().hasOnly(["projectType", "tattooIdea", "colourPreference", "placement", "bodySide", "sizeCategory", "detailLevel"])
        && data.project.projectType in ["full_sleeve", "half_sleeve", "leg_sleeve", "large_leg_piece", "back_piece", "cover_up", "multi_session", "other", "not_sure"]
        && data.project.tattooIdea is string && data.project.tattooIdea.matches('.*\\S.*') && data.project.tattooIdea.size() <= 4000
        && data.project.colourPreference in ["black_and_grey", "colour", "black_grey_with_colour", "not_sure"]
        && data.project.placement is string && data.project.placement.matches('.*\\S.*') && data.project.placement.size() <= 200
        && data.project.bodySide in ["left", "right", "both", "centre", "not_sure"]
        && data.project.sizeCategory in ["palm_sized", "hand_sized", "forearm_sized", "half_sleeve", "full_sleeve", "large_leg_piece", "full_leg", "full_back", "multi_area", "not_sure"]
        && data.project.detailLevel in ["simple", "moderate", "high_detail", "realism", "not_sure"]
        && data.coverUp is map
        && data.coverUp.keys().hasAll(["isCoverUp", "coverUpDescription"])
        && data.coverUp.keys().hasOnly(["isCoverUp", "coverUpDescription"])
        && data.coverUp.isCoverUp in ["yes", "no", "maybe", "partially"]
        && data.coverUp.coverUpDescription is string && data.coverUp.coverUpDescription.size() <= 2000
        && data.budget is map
        && data.budget.keys().hasAll(["tierInterest", "monthlyComfort", "paymentStyle"])
        && data.budget.keys().hasOnly(["tierInterest", "monthlyComfort", "paymentStyle"])
        && data.budget.tierInterest in ["starter", "builder", "commitment", "custom", "not_sure"]
        && data.budget.monthlyComfort in ["under_150", "150", "300", "500", "500_plus", "lump_sum", "not_sure"]
        && data.budget.paymentStyle in ["monthly", "pay_per_session", "larger_deposit", "build_before_booking", "build_between_sessions", "custom", "not_sure"]
        && data.timeline is map
        && data.timeline.keys().hasAll(["planningTimeline", "completionWindow", "availability"])
        && data.timeline.keys().hasOnly(["planningTimeline", "completionWindow", "availability"])
        && data.timeline.planningTimeline in ["immediately", "1_3_months", "3_6_months", "6_12_months", "planning_ahead"]
        && data.timeline.completionWindow in ["yes", "maybe", "no", "artist_estimate"]
        && data.timeline.availability is string && data.timeline.availability.matches('.*\\S.*') && data.timeline.availability.size() <= 2000
        && data.readiness is map
        && data.readiness.keys().hasAll(["readyForConsult", "healthConsiderations", "healthDetails"])
        && data.readiness.keys().hasOnly(["readyForConsult", "healthConsiderations", "healthDetails"])
        && data.readiness.readyForConsult in ["yes", "not_yet", "questions_first"]
        && data.readiness.healthConsiderations in ["yes", "no", "not_sure", "discuss_privately"]
        && data.readiness.healthDetails is string && data.readiness.healthDetails.size() <= 2000
        && data.acknowledgements is map
        && data.acknowledgements.keys().hasAll(["applicationOnly", "noPaymentCollected", "noGuarantee", "notInvestmentLoanDiscount", "mandatoryCostsBeforeEnrollment", "termsBeforeEnrollment", "studioPolicy", "informationAccurate", "contactPermission"])
        && data.acknowledgements.keys().hasOnly(["applicationOnly", "noPaymentCollected", "noGuarantee", "notInvestmentLoanDiscount", "mandatoryCostsBeforeEnrollment", "termsBeforeEnrollment", "studioPolicy", "informationAccurate", "contactPermission"])
        && data.acknowledgements.applicationOnly == true
        && data.acknowledgements.noPaymentCollected == true
        && data.acknowledgements.noGuarantee == true
        && data.acknowledgements.notInvestmentLoanDiscount == true
        && data.acknowledgements.mandatoryCostsBeforeEnrollment == true
        && data.acknowledgements.termsBeforeEnrollment == true
        && data.acknowledgements.studioPolicy == true
        && data.acknowledgements.informationAccurate == true
        && data.acknowledgements.contactPermission == true
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function ownsRecord() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid;
    }

    function createsValidMembershipChangeRequest() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          "clientUid",
          "clientEmail",
          "clientName",
          "requestType",
          "requestStatus",
          "reason",
          "clientAcknowledgement",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "clientEmail",
          "clientName",
          "requestType",
          "requestStatus",
          "reason",
          "clientAcknowledgement",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientName is string
        && request.resource.data.reason is string
        && request.resource.data.requestType in [
          "pause_monthly_payments",
          "cancel_monthly_payments",
          "resume_monthly_payments",
          "change_monthly_amount"
        ]
        && request.resource.data.requestStatus == "new"
        && request.resource.data.clientAcknowledgement is map
        && request.resource.data.clientAcknowledgement.keys().hasAll([
          "understandsThisIsARequest",
          "understandsStudioMustReview",
          "understandsCreditBalanceDoesNotAutomaticallyDisappear"
        ])
        && request.resource.data.clientAcknowledgement.keys().hasOnly([
          "understandsThisIsARequest",
          "understandsStudioMustReview",
          "understandsCreditBalanceDoesNotAutomaticallyDisappear"
        ])
        && request.resource.data.clientAcknowledgement.understandsThisIsARequest is bool
        && request.resource.data.clientAcknowledgement.understandsStudioMustReview is bool
        && request.resource.data.clientAcknowledgement.understandsCreditBalanceDoesNotAutomaticallyDisappear is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function createsValidMembershipOfferResponse() {
      let applicationPath = /databases/$(database)/documents/membershipApplications/$(request.resource.data.applicationId);

      return signedIn()
        && request.resource.data.keys().hasAll([
          "clientUid",
          "applicationId",
          "responseType",
          "responseStatus",
          "clientNote",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "applicationId",
          "responseType",
          "responseStatus",
          "clientNote",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.clientUid is string
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.applicationId is string
        && request.resource.data.responseType is string
        && request.resource.data.responseType in [
          "request_accept_offer",
          "ask_question",
          "decline_offer"
        ]
        && request.resource.data.responseStatus is string
        && request.resource.data.responseStatus == "new"
        && request.resource.data.clientNote is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(applicationPath)
        && get(applicationPath).data.clientUid == request.auth.uid;
    }

    function createsOwnClientProfile(clientId) {
      return signedIn()
        && request.auth.uid == clientId
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "clientName",
          "clientEmail",
          "phone",
          "instagram",
          "status",
          "source",
          "createdAt",
          "updatedAt"
        ]);
    }

    function createsOwnMessage() {
      return signedIn()
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == "client";
    }

    function clientUpdatesOwnConversation() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessagePreview",
          "lastMessageAt",
          "unreadForAdmin",
          "unreadForClient",
          "updatedAt"
        ]);
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /paymentCheckoutRequests/{requestId} {
      allow read, write: if false;
    }

    match /paymentCheckoutRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /clients/{clientId} {
      allow create: if isAdmin() || createsOwnClientProfile(clientId);
      allow read: if isAdmin() || (signedIn() && request.auth.uid == clientId);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipApplications/{applicationId} {
      allow create: if createsValidMembershipApplication();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /consultRequests/{consultRequestId} {
      allow create: if createsOwnRecord();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isAdmin() || createsOwnRecord();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin() || clientUpdatesOwnConversation();
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if isAdmin() || createsOwnMessage();
      allow read: if isAdmin() || ownsRecord();
      allow update: if false;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Financial records are written only by trusted server code through Admin SDK.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    match /paymentWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /paymentTransactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /membershipOffers/{offerId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipOfferResponses/{responseId} {
      allow create: if createsValidMembershipOfferResponse();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipChangeRequests/{requestId} {
      allow create: if createsValidMembershipChangeRequest();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /projectTimeline/{entryId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (ownsRecord() && resource.data.clientVisible == true);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /creditLedger/{entryId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || ownsRecord();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
