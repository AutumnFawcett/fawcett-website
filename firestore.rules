        && (!("membershipOffer" in data) || portalMapMembershipOffer(data, source, enforceTypes))
        && (!("clientProjectSummary" in data) || (collectionName == "projects"
          && data.clientProjectSummary is string
          && data.clientProjectSummary == source.get("adminReview", {}).get("clientProjectSummary", source.get("clientProjectSummary", ""))))
        && (collectionName != "membershipOffers" || data.get("offerStatus", data.get("status", "")) in ["membership_offer_sent","client_reviewing_offer","membership_approved","membership_active","membership_paused","membership_cancelled","accepted","declined"])
        && (!("membershipOffer" in data) || data.membershipOffer.offerStatus in ["membership_offer_sent","client_reviewing_offer","membership_approved","membership_active","membership_paused","membership_cancelled","accepted","declined"])
        && (collectionName != "projectTimeline" || (data.clientVisible == true && !(data.entryType in ["health_skin_note","internal_note","admin_note"])));
    }

    // Client source schemas validate submitted values once. Clients may only
    // mirror a newly created own record or change own conversation read state.
    // Whole nested maps must match, so they cannot copy private review/health.
    function validClientPortalProjection(collectionName, data, source) {
      let difference = data.diff(source);
      return data.clientUid == request.auth.uid && data.clientUid == source.clientUid
        && data.keys().hasOnly(portalKeys(collectionName))
        && publicArtistReference(data)
        && difference.addedKeys().size() == 0
        && difference.changedKeys().size() == 0;
    }

    match /portalRecords/{sourceCollection}/records/{recordId} {
      function sourcePath() {
        return /databases/$(database)/documents/$(sourceCollection)/$(recordId);
      }
      function validProjection() {
        let path = sourcePath();
        let source = getAfter(path).data;
        let data = request.resource.data;
        return existsAfter(path)
          && (isAdmin()
            ? validPortalProjection(sourceCollection, data, source, true)
            : validClientPortalProjection(sourceCollection, data, source));
      }
      function createsClientProjection() {
        return signedIn()
          && sourceCollection in ["clients", "consultRequests", "membershipApplications", "conversations", "messages", "membershipOfferResponses", "membershipChangeRequests"]
          && request.resource.data.clientUid == request.auth.uid
          && !exists(sourcePath()) && validProjection();
      }
      function updatesClientConversation() {
        return signedIn() && sourceCollection == "conversations"
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.clientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessagePreview", "lastMessageAt", "unreadForAdmin", "unreadForClient", "updatedAt"])
          && validProjection();
      }
      allow get: if signedIn() && sourceCollection == "clients" && recordId == request.auth.uid
        && !exists(/databases/$(database)/documents/portalRecords/$(sourceCollection)/records/$(recordId));
      allow read: if isAdmin() || (signedIn()
        && sourceCollection in ["clients","consultRequests","membershipApplications","conversations","messages","projects","appointments","payments","creditLedger","membershipOffers","membershipOfferResponses","membershipChangeRequests","projectTimeline"]
        && resource.data.clientUid == request.auth.uid
        && (sourceCollection != "projectTimeline" || resource.data.clientVisible == true));
      allow create: if (isAdmin() && validProjection()) || createsClientProjection();
      allow update: if (isAdmin() && validProjection()) || updatesClientConversation();
      // Only derived views may be withdrawn; original history cannot be deleted.
      allow delete: if isAdmin();
    }
