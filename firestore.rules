        && data.clientUid is string && data.clientUid == source.clientUid
        && data.keys().hasOnly(portalKeys(collectionName))
        && publicArtistReference(data)
        && scalarPortalFields(collectionName, data)
        && (collectionName != "clients" || !("source" in data) || data.source is string)
        && samePortalLinks(data, source)
        && (!("source" in data) || (collectionName == "clients" ? data.source == source.source : (portalMapSource(data, source, enforceTypes) && data.source == source.source)))
        && (!("project" in data) || portalMapProject(data, source, enforceTypes))
        && (!("request" in data) || portalMapRequest(data, source, enforceTypes))
