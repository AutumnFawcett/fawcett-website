    function publicArtistReference(data) {
      return !("assignedArtistId" in data)
        || data.assignedArtistId in [null, "artist_ben", "artist_autumn", "ben", "autumn"];
    }

    function samePortalLinks(data, source) {
      return (!("projectId" in data) || data.projectId == source.get("projectId", null))
        && (!("applicationId" in data) || data.applicationId == source.get("applicationId", null))
        && (!("consultRequestId" in data) || data.consultRequestId == source.get("consultRequestId", null))
        && (!("appointmentId" in data) || data.appointmentId == source.get("appointmentId", null))
