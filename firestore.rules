rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function createsOwnRecord() {
      return signedIn()
        && request.resource.data.clientUid == request.auth.uid;
    }

    function createsValidMembershipApplication() {
      let data = request.resource.data;

      return signedIn()
        && data.keys().hasAll([
          "programName", "applicationType", "clientUid", "clientEmail",
          "clientName", "phone", "instagram", "preferredContactMethod",
          "status", "preferredArtist", "project", "coverUp", "budget",
          "timeline", "readiness", "acknowledgements", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "programName", "applicationType", "clientUid", "clientEmail",
          "clientName", "phone", "instagram", "preferredContactMethod",
          "status", "preferredArtist", "project", "coverUp", "budget",
          "timeline", "readiness", "acknowledgements", "createdAt", "updatedAt"
        ])
        && data.programName == "Tattoo Project Membership Program"
        && data.applicationType == "founding_member_interest"
        && data.clientUid is string && data.clientUid == request.auth.uid
        && data.clientEmail is string && data.clientEmail.matches('.*\\S.*') && data.clientEmail.size() <= 320
        && data.clientName is string && data.clientName.matches('.*\\S.*') && data.clientName.size() <= 120
        && data.phone is string && data.phone.matches('.*\\S.*') && data.phone.size() <= 50
        && data.instagram is string && data.instagram.size() <= 100
        && data.preferredContactMethod in ["email", "text", "phone", "instagram"]
        && data.status == "new"
        && data.preferredArtist in ["ben", "autumn", "no_preference", "not_sure"]
        && data.project is map
        && data.project.keys().hasAll(["projectType", "tattooIdea", "colourPreference", "placement", "bodySide", "sizeCategory", "detailLevel"])
        && data.project.keys().hasOnly(["projectType", "tattooIdea", "colourPreference", "placement", "bodySide", "sizeCategory", "detailLevel"])
        && data.project.projectType in ["full_sleeve", "half_sleeve", "leg_sleeve", "large_leg_piece", "back_piece", "cover_up", "multi_session", "other", "not_sure"]
        && data.project.tattooIdea is string && data.project.tattooIdea.matches('.*\\S.*') && data.project.tattooIdea.size() <= 4000
        && data.project.colourPreference in ["black_and_grey", "colour", "black_grey_with_colour", "not_sure"]
        && data.project.placement is string && data.project.placement.matches('.*\\S.*') && data.project.placement.size() <= 200
        && data.project.bodySide in ["left", "right", "both", "centre", "not_sure"]
        && data.project.sizeCategory in ["palm_sized", "hand_sized", "forearm_sized", "half_sleeve", "full_sleeve", "large_leg_piece", "full_leg", "full_back", "multi_area", "not_sure"]
        && data.project.detailLevel in ["simple", "moderate", "high_detail", "realism", "not_sure"]
        && data.coverUp is map
        && data.coverUp.keys().hasAll(["isCoverUp", "coverUpDescription"])
        && data.coverUp.keys().hasOnly(["isCoverUp", "coverUpDescription"])
        && data.coverUp.isCoverUp in ["yes", "no", "maybe", "partially"]
        && data.coverUp.coverUpDescription is string && data.coverUp.coverUpDescription.size() <= 2000
        && data.budget is map
        && data.budget.keys().hasAll(["tierInterest", "monthlyComfort", "paymentStyle"])
        && data.budget.keys().hasOnly(["tierInterest", "monthlyComfort", "paymentStyle"])
        && data.budget.tierInterest in ["starter", "builder", "commitment", "custom", "not_sure"]
        && data.budget.monthlyComfort in ["under_150", "150", "300", "500", "500_plus", "lump_sum", "not_sure"]
        && data.budget.paymentStyle in ["monthly", "pay_per_session", "larger_deposit", "build_before_booking", "build_between_sessions", "custom", "not_sure"]
        && data.timeline is map
        && data.timeline.keys().hasAll(["planningTimeline", "completionWindow", "availability"])
        && data.timeline.keys().hasOnly(["planningTimeline", "completionWindow", "availability"])
        && data.timeline.planningTimeline in ["immediately", "1_3_months", "3_6_months", "6_12_months", "planning_ahead"]
        && data.timeline.completionWindow in ["yes", "maybe", "no", "artist_estimate"]
        && data.timeline.availability is string && data.timeline.availability.matches('.*\\S.*') && data.timeline.availability.size() <= 2000
        && data.readiness is map
        && data.readiness.keys().hasAll(["readyForConsult", "healthConsiderations", "healthDetails"])
        && data.readiness.keys().hasOnly(["readyForConsult", "healthConsiderations", "healthDetails"])
        && data.readiness.readyForConsult in ["yes", "not_yet", "questions_first"]
        && data.readiness.healthConsiderations in ["yes", "no", "not_sure", "discuss_privately"]
        && data.readiness.healthDetails is string && data.readiness.healthDetails.size() <= 2000
        && data.acknowledgements is map
        && data.acknowledgements.keys().hasAll(["applicationOnly", "noPaymentCollected", "noGuarantee", "notInvestmentLoanDiscount", "mandatoryCostsBeforeEnrollment", "termsBeforeEnrollment", "studioPolicy", "informationAccurate", "contactPermission"])
        && data.acknowledgements.keys().hasOnly(["applicationOnly", "noPaymentCollected", "noGuarantee", "notInvestmentLoanDiscount", "mandatoryCostsBeforeEnrollment", "termsBeforeEnrollment", "studioPolicy", "informationAccurate", "contactPermission"])
        && data.acknowledgements.applicationOnly == true
        && data.acknowledgements.noPaymentCollected == true
        && data.acknowledgements.noGuarantee == true
        && data.acknowledgements.notInvestmentLoanDiscount == true
        && data.acknowledgements.mandatoryCostsBeforeEnrollment == true
        && data.acknowledgements.termsBeforeEnrollment == true
        && data.acknowledgements.studioPolicy == true
        && data.acknowledgements.informationAccurate == true
        && data.acknowledgements.contactPermission == true
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function ownsRecord() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid;
    }

    function createsValidMembershipChangeRequest() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          "clientUid",
          "clientEmail",
          "clientName",
          "requestType",
          "requestStatus",
          "reason",
          "clientAcknowledgement",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "clientEmail",
          "clientName",
          "requestType",
          "requestStatus",
          "reason",
          "clientAcknowledgement",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientName is string
        && request.resource.data.reason is string
        && request.resource.data.requestType in [
          "pause_monthly_payments",
          "cancel_monthly_payments",
          "resume_monthly_payments",
          "change_monthly_amount"
        ]
        && request.resource.data.requestStatus == "new"
        && request.resource.data.clientAcknowledgement is map
        && request.resource.data.clientAcknowledgement.keys().hasAll([
          "understandsThisIsARequest",
          "understandsStudioMustReview",
          "understandsCreditBalanceDoesNotAutomaticallyDisappear"
        ])
        && request.resource.data.clientAcknowledgement.keys().hasOnly([
          "understandsThisIsARequest",
          "understandsStudioMustReview",
          "understandsCreditBalanceDoesNotAutomaticallyDisappear"
        ])
        && request.resource.data.clientAcknowledgement.understandsThisIsARequest is bool
        && request.resource.data.clientAcknowledgement.understandsStudioMustReview is bool
        && request.resource.data.clientAcknowledgement.understandsCreditBalanceDoesNotAutomaticallyDisappear is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function createsValidMembershipOfferResponse() {
      let applicationPath = /databases/$(database)/documents/membershipApplications/$(request.resource.data.applicationId);

      return signedIn()
        && request.resource.data.keys().hasAll([
          "clientUid",
          "applicationId",
          "responseType",
          "responseStatus",
          "clientNote",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "applicationId",
          "responseType",
          "responseStatus",
          "clientNote",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.clientUid is string
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.applicationId is string
        && request.resource.data.responseType is string
        && request.resource.data.responseType in [
          "request_accept_offer",
          "ask_question",
          "decline_offer"
        ]
        && request.resource.data.responseStatus is string
        && request.resource.data.responseStatus == "new"
        && request.resource.data.clientNote is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && exists(applicationPath)
        && get(applicationPath).data.clientUid == request.auth.uid;
    }

    function createsOwnClientProfile(clientId) {
      return signedIn()
        && scalarPortalFields("clients", request.resource.data)
        && (!("source" in request.resource.data) || request.resource.data.source is string)
        && request.auth.uid == clientId
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "clientUid",
          "clientName",
          "clientEmail",
          "phone",
          "instagram",
          "status",
          "source",
          "createdAt",
          "updatedAt"
        ]);
    }

    function ownLinkedRecord(data, field, collectionName) {
      let id = data.get(field, null);
      return id == null || (id is string
        && existsAfter(/databases/$(database)/documents/$(collectionName)/$(id))
        && getAfter(/databases/$(database)/documents/$(collectionName)/$(id)).data.clientUid == data.clientUid);
    }

    function validClientLinks(data) {
      return ownLinkedRecord(data, "applicationId", "membershipApplications")
        && ownLinkedRecord(data, "consultRequestId", "consultRequests")
        && ownLinkedRecord(data, "membershipChangeRequestId", "membershipChangeRequests")
        && ownLinkedRecord(data, "membershipOfferResponseId", "membershipOfferResponses");
    }

    function createsOwnConsult() {
      let data = request.resource.data;
      return createsOwnRecord() && scalarPortalFields("consultRequests", data)
        && (!("request" in data) || portalMapRequest(data, data, true))
        && (!("coverUp" in data) || portalMapCoverUp(data, data, true))
        && (!("timeline" in data) || portalMapTimeline(data, data, true))
        && (!("acknowledgements" in data) || portalMapAcknowledgements(data, data, true))
        && data.keys().hasOnly(["clientUid", "clientName", "clientEmail", "phone", "instagram", "preferredContactMethod", "preferredArtist", "assignedInbox", "assignedArtistId", "status", "request", "coverUp", "timeline", "readiness", "acknowledgements", "createdAt", "updatedAt"])
        && data.status == "new"
        && data.readiness is map
        && data.readiness.keys().hasOnly(["healthNotes"])
        && data.readiness.healthNotes is string && data.readiness.healthNotes.size() <= 2000
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    function createsOwnConversation() {
      let data = request.resource.data;
      return createsOwnRecord() && validClientLinks(data) && scalarPortalFields("conversations", data)
        && data.keys().hasOnly(["clientUid", "clientName", "clientEmail", "applicationId", "consultRequestId", "membershipChangeRequestId", "membershipOfferResponseId", "sourceType", "sourceId", "assignedInbox", "assignedArtistId", "status", "subject", "lastMessagePreview", "lastMessageAt", "unreadForAdmin", "unreadForClient", "createdAt", "updatedAt"])
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    function createsOwnMessage() {
      let data = request.resource.data;
      let conversation = /databases/$(database)/documents/conversations/$(data.conversationId);
      return signedIn() && data.clientUid == request.auth.uid && scalarPortalFields("messages", data)
        && data.senderUid == request.auth.uid && data.senderRole == "client"
        && data.body is string && data.body.size() > 0 && data.body.size() <= 10000
        && data.createdAt == request.time
        && data.keys().hasOnly(["clientUid", "clientEmail", "conversationId", "applicationId", "consultRequestId", "membershipChangeRequestId", "membershipOfferResponseId", "sourceType", "sourceId", "senderUid", "senderRole", "senderName", "body", "createdAt"])
        && existsAfter(conversation)
        && getAfter(conversation).data.clientUid == request.auth.uid
        && data.get("applicationId", null) == getAfter(conversation).data.get("applicationId", null)
        && data.get("consultRequestId", null) == getAfter(conversation).data.get("consultRequestId", null)
        && validClientLinks(data);
    }

    function clientUpdatesOwnConversation() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.get("lastMessagePreview", "") is string
        && request.resource.data.get("lastMessagePreview", "").size() <= 180
        && request.resource.data.get("unreadForAdmin", true) is bool
        && request.resource.data.get("unreadForClient", false) is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessagePreview",
          "lastMessageAt",
          "unreadForAdmin",
          "unreadForClient",
          "updatedAt"
        ]);
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /paymentCheckoutRequests/{requestId} {
      allow read, write: if false;
    }

    match /paymentCheckoutRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /clients/{clientId} {
      allow create: if isAdmin() || createsOwnClientProfile(clientId);
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipApplications/{applicationId} {
      allow create: if createsValidMembershipApplication();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /consultRequests/{consultRequestId} {
      allow create: if createsOwnConsult();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isAdmin() || createsOwnConversation();
      allow read: if isAdmin();
      allow update: if isAdmin() || clientUpdatesOwnConversation();
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if isAdmin() || createsOwnMessage();
      allow read: if isAdmin();
      // Preserve message text/sender/history while allowing private admin review.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["adminReview", "status", "assignedInbox", "assignedArtistId", "unreadForAdmin", "updatedAt"]);
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Financial records are written only by trusted server code through Admin SDK.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    match /paymentWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /paymentTransactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /founderCounters/{counterId} {
      allow read, write: if false;
    }

    match /founderContributions/{contributionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /founderProfiles/{profileId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /membershipOffers/{offerId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipOfferResponses/{responseId} {
      allow create: if createsValidMembershipOfferResponse();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /membershipChangeRequests/{requestId} {
      allow create: if createsValidMembershipChangeRequest();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /projectTimeline/{entryId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /creditLedger/{entryId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
    // Portal documents are explicit projections. Source IDs and Auth UIDs stay
    // unchanged; original collections above are private, including legacy data.
    function portalKeys(collectionName) {
      return collectionName == "clients" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","status","source","preferredArtist"] :
        collectionName == "consultRequests" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","preferredContactMethod","preferredArtist","assignedInbox","assignedArtistId","status","request","coverUp","timeline","acknowledgements","projectId","conversationId"] :
        collectionName == "membershipApplications" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","programName","applicationType","preferredContactMethod","preferredArtist","assignedInbox","assignedArtistId","status","project","coverUp","budget","timeline","acknowledgements","membershipOffer","projectId","conversationId"] :
        collectionName == "conversations" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","applicationId","consultRequestId","membershipChangeRequestId","membershipOfferResponseId","sourceType","sourceId","assignedInbox","assignedArtistId","status","subject","lastMessagePreview","lastMessageAt","unreadForAdmin","unreadForClient"] :
        collectionName == "messages" ? ["clientUid","clientEmail","conversationId","applicationId","consultRequestId","membershipChangeRequestId","membershipOfferResponseId","sourceType","sourceId","senderRole","senderName","body","createdAt"] :
        collectionName == "projects" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","consultRequestId","applicationId","projectName","status","assignedInbox","assignedArtistId","preferredArtist","source","membership","project","coverUp","timeline","estimate","mandatoryCosts","clientProjectSummary"] :
        collectionName == "appointments" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","projectId","projectName","title","appointmentType","type","status","startAt","endAt","durationMinutes","assignedInbox","assignedArtistId","location","clientVisibleNotes"] :
        collectionName == "payments" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","projectId","projectName","appointmentId","appointmentTitle","paymentType","paymentMethod","creditHandling","status","amountCents","amountDisplay","currency","receivedAt","amount","paymentAmount","type"] :
        collectionName == "creditLedger" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","projectId","projectName","paymentId","appointmentId","entryType","transactionType","status","deltaCents","amountCents","currency","description","title","reason","receivedAt"] :
        collectionName == "membershipOffers" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","applicationId","projectId","tier","tierLabel","status","initialPaymentCents","monthlyPaymentCents","minimumProjectValueCents","paymentStartDate","termsSummary","clientMessage","offerStatus","sentAt"] :
        collectionName == "membershipOfferResponses" ? ["clientUid","applicationId","responseType","responseStatus","clientNote","createdAt","updatedAt"] :
        collectionName == "membershipChangeRequests" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","requestType","requestStatus","reason","clientAcknowledgement"] :
        collectionName == "projectTimeline" ? ["clientUid","clientName","clientEmail","phone","instagram","createdAt","updatedAt","projectId","projectName","entryType","status","title","body","clientVisible","important"] : [];
    }

    function scalarPortalFields(collectionName, data) {
      return collectionName == "clients" ? ((!("clientUid" in data) || data.clientUid is string) && (!("clientName" in data) || data.clientName is string) && (!("clientEmail" in data) || data.clientEmail is string) && (!("phone" in data) || data.phone is string) && (!("instagram" in data) || data.instagram is string) && (!("createdAt" in data) || (data.createdAt == null || data.createdAt is timestamp)) && (!("updatedAt" in data) || (data.updatedAt == null || data.updatedAt is timestamp)) && (!("status" in data) || data.status is string) && (!("preferredArtist" in data) || data.preferredArtist is string)) :
        collectionName == "consultRequests" ? ((!("clientUid" in data) || data.clientUid is string) && (!("clientName" in data) || data.clientName is string) && (!("clientEmail" in data) || data.clientEmail is string) && (!("phone" in data) || data.phone is string) && (!("instagram" in data) || data.instagram is string) && (!("createdAt" in data) || (data.createdAt == null || data.createdAt is timestamp)) && (!("updatedAt" in data) || (data.updatedAt == null || data.updatedAt is timestamp)) && (!("preferredContactMethod" in data) || data.preferredContactMethod is string) && (!("preferredArtist" in data) || data.preferredArtist is string) && (!("assignedInbox" in data) || data.assignedInbox is string) && (!("status" in data) || data.status is string) && (!("projectId" in data) || (data.projectId == null || data.projectId is string)) && (!("conversationId" in data) || (data.conversationId == null || data.conversationId is string))) :
        collectionName == "membershipApplications" ? ((!("clientUid" in data) || data.clientUid is string) && (!("clientName" in data) || data.clientName is string) && (!("clientEmail" in data) || data.clientEmail is string) && (!("phone" in data) || data.phone is string) && (!("instagram" in data) || data.instagram is string) && (!("createdAt" in data) || (data.createdAt == null || data.createdAt is timestamp)) && (!("updatedAt" in data) || (data.updatedAt == null || data.updatedAt is timestamp)) && (!("programName" in data) || data.programName is string) && (!("applicationType" in data) || data.applicationType is string) && (!("preferredContactMethod" in data) || data.preferredContactMethod is string) && (!("preferredArtist" in data) || data.preferredArtist is string) && (!("assignedInbox" in data) || data.assignedInbox is string) && (!("status" in data) || data.status is string) && (!("projectId" in data) || (data.projectId == null || data.projectId is string)) && (!("conversationId" in data) || (data.conversationId == null || data.conversationId is string))) :
        collectionName == "conversations" ? ((!("clientUid" in data) || data.clientUid is string) && (!("clientName" in data) || data.clientName is string) && (!("clientEmail" in data) || data.clientEmail is string) && (!("phone" in data) || data.phone is string) && (!("instagram" in data) || data.instagram is string) && (!("createdAt" in data) || (data.createdAt == null || data.createdAt is timestamp)) && (!("updatedAt" in data) || (data.updatedAt == null || data.updatedAt is timestamp)) && (!("applicationId" in data) || (data.applicationId == null || data.applicationId is string)) && (!("consultRequestId" in data) || (data.consultRequestId == null || data.consultRequestId is string)) && (!("membershipChangeRequestId" in data) || (data.membershipChangeRequestId == null || data.membershipChangeRequestId is string)) && (!("membershipOfferResponseId" in data) || (data.membershipOfferResponseId == null || data.membershipOfferResponseId is string)) && (!("sourceType" in data) || data.sourceType is string) && (!("sourceId" in data) || (data.sourceId == null || data.sourceId is string)) && (!("assignedInbox" in data) || data.assignedInbox is string) && (!("status" in data) || data.status is string) && (!("subject" in data) || data.subject is string) && (!("lastMessagePreview" in data) || data.lastMessagePreview is string) && (!("lastMessageAt" in data) || (data.lastMessageAt == null || data.lastMessageAt is timestamp)) && (!("unreadForAdmin" in data) || data.unreadForAdmin is bool) && (!("unreadForClient" in data) || data.unreadForClient is bool)) :
        collectionName == "messages" ? ((!("clientUid" in data) || data.clientUid is string) && (!("clientEmail" in data) || data.clientEmail is string) && (!("conversationId" in data) || (data.conversationId == null || data.conversationId is string)) && (!("applicationId" in data) || (data.applicationId == null || data.applicationId is string)) && (!("consultRequestId" in data) || (data.consultRequestId == null || data.consultRequestId is string)) && (!("membershipChangeRequestId" in data) || (data.membershipChangeRequestId == null || data.membershipChangeRequestId is string)) && (!("membershipOfferResponseId" in data) || (data.membershipOfferResponseId == null || data.membershipOfferResponseId is string)) && (!("sourceType" in data) || data.sourceType is string) && (!("sourceId" in data) || (data.sourceId == null || data.sourceId is string)) && (!("senderRole" in data) || data.senderRole is string) && (!("senderName" in data) || data.senderName is string) && (!("body" in data) || data.body is string) && (!("createdAt" in data) || (data.createdAt == null || data.createdAt is timestamp))) :
